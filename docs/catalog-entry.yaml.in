# Template only — substitute the verified immutable commit.
name: jot
repo: https://github.com/Totoro-qaq/hermes-jot
sha: '@FULL_COMMIT_SHA@'
description: Human-editable notes, checklists and documents for Hermes Desktop, with optional agent collaboration.
maintainer: Totoro-qaq
tier: community
category: desktop
requires_hermes: '>=0.21.5'
version: '0.1.0'
title: 'Jot'
readme: true
screenshots:
  - https://raw.githubusercontent.com/Totoro-qaq/hermes-jot/@FULL_COMMIT_SHA@/assets/readme/workspace.en.jpg
  - https://raw.githubusercontent.com/Totoro-qaq/hermes-jot/@FULL_COMMIT_SHA@/assets/readme/sidebar.en.jpg
known_issues:
  - Requires a current Hermes Desktop build with SandboxedFrame and gateway file-download SDK support.
  - Word attachments use download or the default application; the tested host does not render DOCX.
capabilities:
  provides_tools: [jot_list, jot_read, jot_create, jot_update, jot_set_task, jot_delete]
  provides_hooks: []
  provides_middleware: []
  requires_env: []
